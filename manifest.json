{
  "manifest_version": 3,
  "minimum_chrome_version": "116",
  "name": "Super Dribble Audio Amplifier",
  "version": "1.0",
  "description": "A Chrome extension to amplify and control audio in any tab.",
  "permissions": [
    "activeTab",
    "tabCapture",
    "tabs",
    "storage",
    "scripting",
    "offscreen"
  ],
  "action": {
    "default_popup": "UI/build/index.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
